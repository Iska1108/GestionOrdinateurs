@GestionOrdinateurs.API_HostAddress = http://localhost:5157

# TP4 - Etat : 0=EnService 1=EnPanne 2=EnMaintenance 3=HorsService 4=Lent 5=Reparable
# TP4 - TypeOrdi : 0=Portable 1=Fixe 2=Server

### TP4 - Partie 1 : ajout de l'ordinateur Dell XPS 15
POST {{GestionOrdinateurs.API_HostAddress}}/api/ordinateurs
Content-Type: application/json

{
  "nom": "Dell XPS 15",
  "etat": 0,
  "stock": 3,
  "prix": 1800,
  "caracteristiques": {
    "ramGo": 16,
    "stockageGo": 1000,
    "typeOrdi": 0,
    "marque": "Dell",
    "processeur": "Intel Core i7"
  }
}


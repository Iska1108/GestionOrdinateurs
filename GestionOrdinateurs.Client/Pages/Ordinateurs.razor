@page "/ordinateurs"
@using System.Net.Http.Headers
@using Blazored.SessionStorage
@using GestionOrdinateurs.Client.Models
@using GestionOrdinateurs.Client.Services
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<PageTitle>Ordinateurs</PageTitle>

<h1>Liste des ordinateurs</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prix</th>
            <th>Devise</th>
            <th>Vendu</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ordinateur in ordinateurs)
        {
            <tr>
                <td>@ordinateur.Nom</td>
                <td>@ordinateur.Prix</td>
                @* TP5 : le prix est en euros en base *@
                <td>EUR</td>
                <td>@ordinateur.Vendu</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<OrdinateurModele> ordinateurs = new();

    //TP5 : récupère la liste des ordinateurs via la Gateway avec le token en session
    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>(CustomAuthStateProvider.CleToken);

        var client = HttpClientFactory.CreateClient("Gateway");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        ordinateurs = await client.GetFromJsonAsync<List<OrdinateurModele>>("api/ordinateurs") ?? new();
    }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ordinateurs-route": {
        "ClusterId": "gestionordinateurs-cluster",
        "Match": {
          "Path": "/api/ordinateurs/{**catch-all}"
        }
      },
      "reparations-route": {
        "ClusterId": "gestionordinateurs-cluster",
        "Match": {
          "Path": "/api/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionordinateurs-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://gestionordinateurs-api:5157/"
          }
        }
      }
    }
  }
}
